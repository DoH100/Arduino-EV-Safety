
#include <Adafruit_NeoPixel.h>

// =====================================
// 1. 핀 설정
// =====================================
#define LED_PIN       6
#define LED_COUNT     180
#define TRIG_PIN      9
#define ECHO_PIN      10
#define BRAKE_PIN     2
#define RELAY_PIN     5

// Active LOW 릴레이
#define RELAY_ON      LOW
#define RELAY_OFF     HIGH

// =====================================
// 2. 거리 설정
// =====================================
const float EMERGENCY_DIST = 150.0;
const float EMERGENCY_RELEASE_DIST = 160.0;

const float RED_DIST = 150.0;
const float ORANGE_DIST = 300.0;

// =====================================
// 3. 시간 설정
// =====================================
//긴급제동 반응지연시간 고려 시간 줄임
const unsigned long SENSOR_INTERVAL = 100;
const unsigned long BRAKE_DEBOUNCE = 30;
const unsigned long ECHO_TIMEOUT_US = 30000UL;

const int BRIGHTNESS = 10;

// =====================================
// 4. LED 설정
// =====================================
Adafruit_NeoPixel strip(
  LED_COUNT,
  LED_PIN,
  NEO_GRB + NEO_KHZ800
);

enum LedLevel {
  SAFE,
  DANGER,
  CRITICAL,
  BRAKE_ACTIVE
};

// 사용하지 않는 SENSOR_ERROR 관련 상태값 제거 및 기본값 정리
LedLevel currentLevel = SAFE;

unsigned long lastBlinkTime = 0;
bool blinkOn = false;

// =====================================
// 5. 초음파 센서 상태
// =====================================
float distanceCm = -1;
bool sensorValid = false;

unsigned long lastSensorTime = 0;

// =====================================
// 6. 브레이크 입력 상태
// =====================================
bool brakePressed = false;
bool lastBrakeReading = false;
unsigned long lastDebounceTime = 0;

// =====================================
// 7. 릴레이 제어 상태
// =====================================

// 일반 수동 브레이크 토글
bool manualStop = false;

// 긴급제동 상태
bool emergencyStop = true;

// 긴급제동 수동 해제 상태
// true = 긴급제동 일시 해제
bool emergencyOverride = false;

// 현재 릴레이 상태
bool relayOn = true;

// =====================================
// 8. 초음파 거리 측정 (3회 측정 후 평균 반영)
// =====================================
float readDistance() {
  const int samples = 3;
  float validSum = 0;
  int validCount = 0;

  for (int i = 0; i < samples; i++) {
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(3);

    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(TRIG_PIN, LOW);

    unsigned long duration = pulseIn(
      ECHO_PIN,
      HIGH,
      ECHO_TIMEOUT_US
    );

    // 응답이 있고 유효 범위(2~400cm)인 경우만 합산
    if (duration > 0) {
      float cm = duration * 0.0343 / 2.0;
      if (cm >= 2.0 && cm <= 400.0) {
        validSum += cm;
        validCount++;
      }
    }
    
    // 측정 간 간섭을 막기 위한 아주 짧은 딜레이 (5ms)
    delay(5);
  }

  // 유효한 값이 하나도 없다면 측정 실패(-1 반환)
  if (validCount == 0) {
    return -1;
  }

  // 3번 중 유효했던 값들의 평균 반환
  return validSum / validCount;
}

// =====================================
// 9. 브레이크 버튼 처리
// =====================================
void updateBrake() {

  bool reading =
    digitalRead(BRAKE_PIN) == LOW;

  if (reading != lastBrakeReading) {
    lastDebounceTime = millis();
  }

  if (millis() - lastDebounceTime <
      BRAKE_DEBOUNCE) {

    lastBrakeReading = reading;
    return;
  }

  if (reading != brakePressed) {

    brakePressed = reading;

    if (brakePressed) {

      Serial.println("BRAKE PRESSED");

      // =================================
      // 긴급제동 중 버튼을 누른 경우
      // =================================
      if (emergencyStop && !emergencyOverride) {

        emergencyOverride = true;

        // 수동 정지도 해제
        manualStop = false;

        Serial.println("EMERGENCY OVERRIDE ON");
        Serial.println("MANUAL STOP OFF");

      } else {

        // 일반 상황에서는 기존 토글 유지
        manualStop = !manualStop;

        Serial.println(
          manualStop
            ? "MANUAL STOP ON"
            : "MANUAL STOP OFF"
        );
      }

    } else {

      Serial.println("BRAKE RELEASED");
    }
  }

  lastBrakeReading = reading;
}

// =====================================
// 10. 초음파 센서 갱신
// =====================================
void updateSensor() {

  if (millis() - lastSensorTime <
      SENSOR_INTERVAL) {
    return;
  }

  lastSensorTime = millis();

  float measured = readDistance();

  // =================================
  // NO ECHO 처리
  // =================================
  if (measured < 0) {

    sensorValid = false;
    distanceCm = -1;

    Serial.println("Distance: NO ECHO");

    // 기존 긴급제동 상태 유지
    return;
  }

  distanceCm = measured;
  sensorValid = true;

  Serial.print("Distance: ");
  Serial.print(distanceCm, 1);
  Serial.println(" cm");

  // =================================
  // 160cm 이상: 긴급제동 해제 및 재무장
  // =================================
  if (distanceCm >= EMERGENCY_RELEASE_DIST) {

    if (emergencyStop) {
      Serial.println("EMERGENCY RELEASED");
    }

    emergencyStop = false;

    if (emergencyOverride) {
      emergencyOverride = false;
      Serial.println("EMERGENCY OVERRIDE RESET");
    }
  }

  // =================================
  // 150cm 미만: 긴급제동
  // =================================
  else if (distanceCm < EMERGENCY_DIST) {

    if (!emergencyOverride) {
      if (!emergencyStop) {
        Serial.println("EMERGENCY STOP");
      }

      emergencyStop = true;
    }
  }

  // 150~160cm에서는 기존 상태 유지
}

// =====================================
// 11. 실제 릴레이 제어
// =====================================
void updateRelay() {

  // 긴급제동 수동 해제 중에는
  // 자동 긴급제동 신호를 릴레이에 반영하지 않음
  bool effectiveEmergencyStop =
    emergencyStop && !emergencyOverride;

  bool shouldStop =
    manualStop ||
    effectiveEmergencyStop ||
    brakePressed;

  if (shouldStop != relayOn) {

    relayOn = shouldStop;

    digitalWrite(
      RELAY_PIN,
      relayOn ? RELAY_ON : RELAY_OFF
    );

    Serial.println(
      relayOn
        ? "RELAY ON"
        : "RELAY OFF"
    );
  }
}

// =====================================
// 12. LED 상태 결정
// =====================================
LedLevel getPriorityLevel() {

  // 브레이크 누르는 동안 빨간색 고정
  if (brakePressed) {
    return BRAKE_ACTIVE;
  }

  // NO ECHO: 초록색 상시 점등
  if (!sensorValid) {
    return SAFE;
  }

  // 150cm 이하: 빨간색 점멸
  if (distanceCm <= RED_DIST) {
    return CRITICAL;
  }

  // 150cm 초과 ~ 300cm 이하: 주황색 점멸
  if (distanceCm <= ORANGE_DIST) {
    return DANGER;
  }

  // 300cm 초과: 초록색 상시 점등
  return SAFE;
}

// =====================================
// 13. LED 전체 출력
// =====================================

// 마지막으로 출력한 LED 색상 저장
uint32_t lastColor = 0;

// LED 최초 출력 여부
bool ledInitialized = false;

void showColor(uint32_t color) {

  // 이전에 출력한 색상과 같으면
  // LED 데이터 재전송하지 않음
  if (ledInitialized && color == lastColor) {
    return;
  }

  // 새로운 색상 저장
  lastColor = color;
  ledInitialized = true;

  // LED 180개 색상 설정
  for (int i = 0; i < LED_COUNT; i++) {
    strip.setPixelColor(i, color);
  }

  // 실제 LED에 데이터 전송
  strip.show();
}

// =====================================
// 14. LED 점멸 제어
// =====================================
void updateLED() {

  LedLevel level = getPriorityLevel();

  if (level != currentLevel) {

    currentLevel = level;
    lastBlinkTime = millis();
    blinkOn = false;
  }

  // 300cm 초과 및 NO ECHO : 초록색 상시 점등
if (level == SAFE) {

  showColor(strip.Color(0, 255, 0));
  return;
}

  // 브레이크 누름: 빨간색 고정
  if (level == BRAKE_ACTIVE) {

    showColor(strip.Color(255, 0, 0));
    return;
  }

  unsigned long interval = 500;
  uint32_t color = 0;

  switch (level) {

    case CRITICAL:
      interval = 100;
      color = strip.Color(255, 0, 0);
      break;

    case DANGER:
      interval = 150;
      color = strip.Color(255, 80, 0);
      break;

    default:
      break;
  }

  if (millis() - lastBlinkTime >= interval) {

    lastBlinkTime = millis();
    blinkOn = !blinkOn;

    showColor(
      blinkOn
        ? color
        : strip.Color(0, 0, 0)
    );
  }
}

// =====================================
// 15. 초기 설정
// =====================================
void setup() {

  Serial.begin(9600);

  // 부팅 시 릴레이 오동작 방지
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_ON);
  

  pinMode(BRAKE_PIN, INPUT_PULLUP);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  digitalWrite(TRIG_PIN, LOW);

  strip.begin();
  strip.setBrightness(BRIGHTNESS);
  strip.clear();
  strip.show();

  brakePressed =
    digitalRead(BRAKE_PIN) == LOW;

  lastBrakeReading = brakePressed;

  manualStop = false;
  emergencyStop = true;
  emergencyOverride = false;
  relayOn = true;

  Serial.println("SYSTEM START");
  Serial.println("BRAKE TOGGLE MODE");
  Serial.println("EMERGENCY OVERRIDE MODE");
  Serial.println("NO ECHO -> GREEN LED");

  Serial.print("EMERGENCY DISTANCE: ");
  Serial.print(EMERGENCY_DIST);
  Serial.println(" cm");

  Serial.print("EMERGENCY RELEASE: ");
  Serial.print(EMERGENCY_RELEASE_DIST);
  Serial.println(" cm");

  Serial.println("RELAY ON - INITIAL SAFETY");
}

// =====================================
// 16. 메인 루프
// =====================================
void loop() {

  updateBrake();
  updateSensor();
  updateRelay();
  updateLED();
}
